# Copy to .env.production.local for the Node.js production frontend.
# Set this before `npm run build`; Next records rewrites in the build output.
# Include the PHP deployment prefix, but do not append /api.
PHP_API_BASE_URL=https://api.buildmanagement.id/rumahflow

# Production frontend: https://rumahflow.rstudiohub.com
# Commands: npm ci && npm run build && npm start
# PORT may be supplied by the hosting platform (Next defaults to 3000).
# The browser calls only /api/... on the frontend origin. This variable is
# server-only; do not rename it NEXT_PUBLIC_* or call the PHP domain directly.
# Configure PHP APP_FRONTEND_ORIGIN=https://rumahflow.rstudiohub.com,
# host-only session cookies with Path=/, and receipt/avatar links as /api/....

# Local development: use this in .env.development.local instead:
# PHP_API_BASE_URL=http://127.0.0.1:8088

# Static mode for serving the entire UI from PHP's public directory:
# npm run build:php
# Copy the contents of frontend/out/ into the PHP public directory manually.
# Preserve the backend index.php, router.php, and .htaccess files.
# Equivalent build-time flag: RUMAHFLOW_STATIC_EXPORT=1 npm run build
# Static mode has no Next runtime/proxy; PHP and the exported UI share an origin.
