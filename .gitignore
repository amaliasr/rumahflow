# GitHub contains only the frontend. Backend is delivered as a private ZIP.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/frontend/

# Generated frontend output and dependencies
/frontend/node_modules/
/frontend/.next/
/frontend/out/

# Local configuration, private data and secrets
.env
.env.*
!/frontend/.env.example
*.log
*.pem
*.key
*.sqlite
*.sqlite-*
*.db
*.xlsx
*.xls
*.csv
.DS_Store
Thumbs.db
